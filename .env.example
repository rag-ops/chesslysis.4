DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NODE_ENV="production"
PORT="10000"
HOSTNAME="0.0.0.0"
STOCKFISH_PATH="/usr/games/stockfish"
# Optional worker secret. When omitted, only the in-container loopback worker is allowed.
ANALYSIS_WORKER_TOKEN="change-me-to-a-long-random-secret"
RUN_DB_PUSH_ON_STARTUP="false"
ANALYSIS_WORKER_ENABLED="true"
# Per-position engine budgets are bounded in code so a constrained CPU cannot stall a job indefinitely.
