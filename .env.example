DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NODE_ENV="production"
PORT="10000"
HOSTNAME="0.0.0.0"
STOCKFISH_PATH="/usr/games/stockfish"
# Required for the production background analysis worker. Use a long random value.
ANALYSIS_WORKER_TOKEN="change-me-to-a-long-random-secret"
ANALYSIS_WORKER_ENABLED="true"
# Per-position engine budgets are bounded in code so a constrained CPU cannot stall a job indefinitely.
RUN_DB_PUSH_ON_STARTUP="true"
ANALYSIS_WORKER_IDLE_MS="2000"
ANALYSIS_WORKER_BUSY_MS="250"
ANALYSIS_STALE_AFTER_MS="300000"
